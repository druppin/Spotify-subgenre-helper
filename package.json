{
  "name": "spotify-subgenre-helper",
  "version": "1.0.0",
  "description": "Sort Spotify songs into playlists with AI subgenre guesses",
  "private": true,
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "api-token": "node scripts/api-token.mjs",
    "lint": "eslint",
    "desktop:prepare": "next build && node scripts/prepare-desktop.mjs",
    "desktop": "npm run desktop:prepare && electron .",
    "desktop:dist": "npm run desktop:prepare && electron-builder --publish never",
    "merge-dev-data": "node scripts/merge-dev-data.mjs"
  },
  "dependencies": {
    "iron-session": "^9.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
