# Optional: everything here can be entered in the app's Settings instead,
# which is the easier way. Values saved in Settings win over this file.
# To use it anyway, copy to .env.local and fill in. See README.md for where
# to get each value.

# --- Spotify ---
# Register an app at https://developer.spotify.com/dashboard
# Its Redirect URI must be http://127.0.0.1:3000/api/auth/callback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Only needed if the app runs somewhere other than 127.0.0.1:3000.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# --- Session ---
# The app makes and saves one itself. Set this only to choose your own
# (32+ characters, e.g. from: openssl rand -base64 32).
# SESSION_SECRET=

# --- Last.fm (optional, degrades gracefully if unset) ---
# Get a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Audio features (danceability/energy/valence/tempo/etc.) come from
# ReccoBeats (src/lib/reccobeats.ts) — free, no API key needed, nothing to
# configure here.

# --- LLM (bring your own key) ---
# provider: one of openai | anthropic | google | groq | openrouter
# anthropic is a paid, pay-as-you-go API key from console.anthropic.com —
# NOT the same thing as a claude.ai Pro/Max subscription, which doesn't cover
# API usage. Cost for this app's short structured-JSON summaries is small.
# Free tiers to prototype with instead, no cost:
#   google  (Google AI Studio: https://aistudio.google.com/apikey) — check
#     https://ai.google.dev/gemini-api/docs/models for the current free-tier
#     Flash model id, naming changes over time (was "gemini-2.0-flash")
#   groq    + model "llama-3.3-70b-versatile" (https://console.groq.com/keys)
#   openrouter + a ":free" model id           (https://openrouter.ai/keys)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Data folder (optional) ---
# Where the library database, caches and logs are kept. Defaults to .cache/
# in the project folder.
# SGH_DATA_DIR=
